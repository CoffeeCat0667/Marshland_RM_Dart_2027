# ============================================================================
# Marshland — Git 属性
# 代码在 Windows 下编辑、在 WSL/Linux 下交叉编译，统一以 LF 入库可避免
# 换行符导致的 CMake / shell 脚本问题。
# ============================================================================

* text=auto eol=lf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.pptx binary
*.docx binary
*.zip  binary

# Windows 专用工程文件保留 CRLF
*.sln  text eol=crlf
*.vcxproj text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 文本文件显式声明
*.c     text
*.cc    text
*.cpp   text
*.cxx   text
*.h     text
*.hh    text
*.hpp   text
*.txt   text
*.md    text
*.json  text
*.cmake text
CMakeLists.txt text
